# Backend Environment Variables (.env.example)

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agenzia_immobiliare
DB_USER=agenzia_user
DB_PASSWORD=agenzia_pass123

# Server
SERVER_PORT=8080
CONTEXT_PATH=/api

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production-with-at-least-256-bits
JWT_EXPIRATION=86400000

# Logging
LOG_LEVEL=INFO
LOG_PACKAGE=it.polimi.agenzia

# File Upload (Future)
UPLOAD_DIR=/tmp/immobili/foto
MAX_FILE_SIZE=10485760

# Email (Future)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@agenzia.it
MAIL_PASSWORD=your-email-password

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development

